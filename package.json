{
  "name": "local-design-studio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "service": "tsx src/service/cli.ts",
    "mcp": "tsx src/service/mcp.ts",
    "studio": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "build:demo": "tsc --noEmit && vite build --mode demo && node scripts/demo-notices.mjs",
    "preview:demo": "vite preview --mode demo --host 127.0.0.1",
    "test:demo": "playwright test --config playwright.demo.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@puckeditor/core": "0.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "license": "MIT",
  "description": "A local-first React design studio with portable project files.",
  "engines": {
    "node": ">=24.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aquahitt/local-design-studio.git"
  },
  "bugs": {
    "url": "https://github.com/aquahitt/local-design-studio/issues"
  },
  "homepage": "https://github.com/aquahitt/local-design-studio#readme"
}
